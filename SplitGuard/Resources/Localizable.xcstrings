    "splitDNS.exceptions.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to standard DNS lookups (UDP port 53). Encrypted DNS and DNS over TCP are not redirected, and traffic still follows Allowed IPs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a consultas DNS estándar (UDP puerto 53). El DNS cifrado y DNS sobre TCP no se redirigen, y el tráfico sigue las IPs permitidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique aux requêtes DNS standard (UDP port 53). Le DNS chiffré et le DNS sur TCP ne sont pas redirigés, et le trafic suit les IP autorisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Standard-DNS-Anfragen (UDP-Port 53). Verschlüsseltes DNS und DNS über TCP werden nicht umgeleitet; der Verkehr folgt weiter den erlaubten IPs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor standaard DNS-aanvragen (UDP-poort 53). Versleutelde DNS en DNS over TCP worden niet omgeleid en verkeer blijft Toegestane IP's volgen."
          }
        }
      }
    },
