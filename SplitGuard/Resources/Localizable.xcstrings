        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor DNS %@ está fuera de las IPs permitidas del túnel; las consultas podrían no llegarle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur DNS %@ est hors des IP autorisées du tunnel ; les requêtes risquent de ne pas l'atteindre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der DNS-Server %@ liegt außerhalb der erlaubten IPs des Tunnels. Anfragen erreichen ihn eventuell nicht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-server %@ valt buiten de Toegestane IP's van de tunnel, waardoor aanvragen deze mogelijk niet bereiken."
          }
        }
      }
    },
    "splitDNS.warning.exclusionCancels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluding \"%1$@\" with subdomains cancels the tunnel DNS domain \"%2$@\". Use \"this name only\" to exclude only the apex."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir \"%1$@\" con subdominios anula el dominio \"%2$@\" del túnel. Usa \"Solo este nombre\" para excluir únicamente la raíz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclure \"%1$@\" avec ses sous-domaines annule le domaine VPN \"%2$@\". Utilisez \"Ce nom uniquement\" pour exclure seulement la racine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn \"%1$@\" mit Subdomains ausgeschlossen wird, hebt das die Tunnel-Domain \"%2$@\" auf. Nutze \"Nur dieser Name\" für den Hauptnamen allein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" met subdomeinen uitsluiten heft het tunneldomein \"%2$@\" op. Kies \"Alleen deze naam\" om alleen het hoofddomein uit te sluiten."
          }
        }
      }
    },
    "splitDNS.warning.exclusionOutside": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not under any tunnel DNS domain, so excluding it has no effect in this mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" no pertenece a ningún dominio DNS del túnel, así que excluirlo no tiene efecto en este modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ne dépend d'aucun domaine DNS du tunnel ; l'exclure n'a aucun effet dans ce mode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" gehört zu keiner Tunnel-DNS-Domain. Diese Ausnahme hat in diesem Modus keine Wirkung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" valt niet onder een tunnel-DNS-domein, dus uitsluiten heeft in deze modus geen effect."
          }
        }
      }
    },
    "splitDNS.warning.noDNSServer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split DNS is enabled, but this tunnel has no DNS server. Add one under DNS servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Split DNS está activo, pero este túnel no tiene servidor DNS. Añade uno en Servidores DNS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Split DNS est activé, mais ce tunnel n'a pas de serveur DNS. Ajoutez-en un dans Serveurs DNS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Split DNS ist aktiv, aber dieser Tunnel hat keinen DNS-Server. Füge unter DNS-Server einen hinzu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Split DNS staat aan, maar deze tunnel heeft geen DNS-server. Voeg er een toe onder DNS-servers."
          }
        }
      }
    },
