    "healthAlerts.deniedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for SplitGuard in iOS Settings. Allow notifications to receive health alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de SplitGuard están desactivadas en Ajustes de iOS. Actívalas para recibir alertas de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour SplitGuard dans les réglages iOS. Autorisez-les pour recevoir les alertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für SplitGuard sind in den iOS-Einstellungen aus. Erlaube sie, um Verbindungsalarme zu erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen voor SplitGuard staan uit in iOS-instellingen. Sta meldingen toe om verbindingsmeldingen te krijgen."
          }
        }
      }
    },
    "healthAlerts.deviceNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only on this device and not included in exports. A recovery alert is also sent once the handshake succeeds again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda solo en este dispositivo y no se exporta. También avisa cuando el handshake vuelve a funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké uniquement sur cet appareil et exclu des exports. Une alerte est aussi envoyée quand le handshake reprend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur auf diesem Gerät gespeichert und nicht exportiert. Sobald der Handshake wieder klappt, folgt eine Entwarnung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt alleen op dit apparaat bewaard en niet meegeëxporteerd. Je krijgt ook een melding zodra de handshake weer lukt."
          }
        }
      }
    },
    "healthAlerts.notification.blocked.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No working handshake for %@. Traffic is blocked until the server responds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin handshake desde hace %@. El tráfico está bloqueado hasta que el servidor responda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun handshake depuis %@. Le trafic reste bloqué jusqu'à la réponse du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit %@ kein Handshake. Der Datenverkehr bleibt blockiert, bis der Server antwortet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al %@ geen werkende handshake. Verkeer blijft geblokkeerd tot de server reageert."
          }
        }
      }
    },
