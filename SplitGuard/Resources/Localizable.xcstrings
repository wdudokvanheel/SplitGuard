    "killSwitch.toggleSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block all traffic outside the tunnel while connected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea todo el tráfico fuera del túnel mientras esté conectado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer tout le trafic hors du tunnel lorsqu'il est connecté"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamten Verkehr außerhalb des Tunnels bei Verbindung blockieren"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeer al het verkeer buiten de tunnel zolang deze verbonden is"
          }
        }
      }
    },
