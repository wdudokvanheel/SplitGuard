    "splitDNS.error.invalidSyntax": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not a valid domain name. Use letters, numbers, hyphens, and dots without wildcards or ports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" no es un dominio válido. Usa letras, números, guiones y puntos, sin comodines ni puertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" n'est pas un nom de domaine valide. Utilisez des lettres, chiffres, tirets et points, sans jokers ni ports."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ist kein gültiger Domainname. Nutze Buchstaben, Zahlen, Bindestriche und Punkte ohne Wildcards oder Ports."
          }
        },
        "nl": {
