    "tunnel.health.noHandshake.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No handshake response. Usual causes: a wrong key, a wrong endpoint, or a blocked port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin respuesta al handshake. Causas habituales: clave incorrecta, endpoint erróneo o puerto bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse au handshake. Causes fréquentes : mauvaise clé, mauvais endpoint ou port bloqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort auf den Handshake. Häufige Ursachen: falscher Schlüssel, falscher Endpunkt oder blockierter Port."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen reactie op de handshake. Meest voorkomend: verkeerde sleutel, verkeerd endpoint of geblokkeerde poort."
          }
        }
      }
    },
