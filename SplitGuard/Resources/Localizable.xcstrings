    "killSwitch.turnedOff.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kill switch was turned off because this tunnel no longer routes all IPv4 traffic (0.0.0.0/0)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactivó el kill switch porque este túnel ya no envía todo el tráfico IPv4 (0.0.0.0/0)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le kill switch a été désactivé car ce tunnel ne route plus tout le trafic IPv4 (0.0.0.0/0)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Killswitch wurde deaktiviert, da dieser Tunnel nicht mehr den gesamten IPv4-Verkehr (0.0.0.0/0) leitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De killswitch is uitgezet omdat deze tunnel niet meer al het IPv4-verkeer (0.0.0.0/0) stuurt."
          }
        }
      }
    },
    "killSwitch.turnedOff.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill Switch Turned Off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill Switch desactivado"
          }
        },
        "fr": {
