    "onboarding.heroBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a WireGuard QR code or import .conf files. Route private domains through VPN DNS while keeping everything else on your normal network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un código QR de WireGuard o importa archivos .conf. Resuelve tus dominios privados con el DNS de la VPN y deja todo lo demás en tu red normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez un QR code WireGuard ou importez des fichiers .conf. Faites passer vos domaines privés par le DNS du VPN et gardez le reste sur votre réseau normal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne einen WireGuard-QR-Code oder importiere .conf-Dateien. Leite private Domains über VPN-DNS und lass alles andere über dein normales Netz laufen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan een WireGuard-QR-code of importeer .conf-bestanden. Stuur privédomeinen via VPN-DNS en laat de rest gewoon via je eigen netwerk lopen."
          }
        }
      }
    },
