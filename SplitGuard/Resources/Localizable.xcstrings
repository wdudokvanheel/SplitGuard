    "killSwitch.allowLocalNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow local network"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir red local"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le réseau local"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Netzwerk erlauben"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaal netwerk toestaan"
          }
        }
      }
    },
    "killSwitch.allowLocalNetwork.subtitle": {
