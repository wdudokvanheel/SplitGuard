    "killSwitch.healthAlertOffer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on health alerts to be notified if the server becomes unreachable while traffic is blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las alertas de conexión para recibir un aviso si el servidor deja de responder mientras el tráfico está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les alertes de connexion pour être prévenu si le serveur devient injoignable pendant le blocage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Verbindungsalarme, um informiert zu werden, wenn der Server bei blockiertem Verkehr nicht erreichbar ist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet verbindingsmeldingen aan om bericht te krijgen als de server onbereikbaar wordt terwijl verkeer is geblokkeerd."
          }
        }
      }
    },
    "killSwitch.ineligibleNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only for tunnels that route all IPv4 traffic (0.0.0.0/0). With split routing, blocking outside traffic would drop everything not in Allowed IPs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo disponible para túneles que envían todo el tráfico IPv4 (0.0.0.0/0). Con enrutamiento dividido, bloquear el tráfico externo cortaría todo lo que no esté en IPs permitidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement pour les tunnels qui routent tout le trafic IPv4 (0.0.0.0/0). En routage partiel, tout ce qui n'est pas dans les IP autorisées serait coupé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Tunnel verfügbar, die den gesamten IPv4-Verkehr (0.0.0.0/0) leiten. Bei Split-Routing würde alles außerhalb der erlaubten IPs blockiert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen beschikbaar voor tunnels die al het IPv4-verkeer (0.0.0.0/0) sturen. Bij split routing valt alles buiten Toegestane IP's anders weg."
          }
        }
      }
    },
    "killSwitch.ipv6Note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tunnel does not route all IPv6 traffic (::/0). IPv6 traffic will be blocked while the kill switch is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este túnel no envía todo el tráfico IPv6 (::/0). El tráfico IPv6 quedará bloqueado mientras el kill switch esté activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tunnel ne route pas tout le trafic IPv6 (::/0). Le trafic IPv6 sera bloqué tant que le kill switch est actif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tunnel leitet nicht den gesamten IPv6-Verkehr (::/0). IPv6-Verkehr wird blockiert, solange der Killswitch aktiv ist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tunnel stuurt niet al het IPv6-verkeer (::/0). IPv6-verkeer wordt geblokkeerd zolang de killswitch aan staat."
          }
        }
      }
    },
    "killSwitch.noDNSNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tunnel has no DNS server configured. Queries travel through the tunnel; a DNS server on the local network is only reachable with Allow local network on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este túnel no tiene servidor DNS configurado. Las consultas pasan por el túnel; un DNS en la red local solo funciona con Permitir red local activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tunnel n'a aucun serveur DNS configuré. Les requêtes passent par le tunnel ; un DNS sur le réseau local nécessite d'activer Autoriser le réseau local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tunnel hat keinen DNS-Server konfiguriert. Anfragen laufen durch den Tunnel; ein lokaler DNS-Server ist nur mit aktiviertem Lokalen Netzwerk erreichbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tunnel heeft geen DNS-server ingesteld. Aanvragen gaan door de tunnel; een DNS-server op het lokale netwerk werkt alleen als Lokaal netwerk toestaan aan staat."
          }
        }
      }
    },
    "killSwitch.onDemandNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection ends when the tunnel is turned off. Turn on On-Demand to keep it connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección termina al apagar el túnel. Activa Bajo demanda para mantenerlo conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection s'arrête quand le tunnel est coupé. Activez À la demande pour le garder connecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schutz endet, wenn der Tunnel ausgeschaltet wird. Aktiviere On-Demand, um ihn verbunden zu halten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bescherming stopt zodra de tunnel uit staat. Zet On-Demand aan om verbonden te blijven."
          }
        }
      }
    },
    "killSwitch.splitDNSNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other names still use the network's DNS server, but the queries now travel through the tunnel. A DNS server on the local network is only reachable with Allow local network on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resto de dominios siguen usando el DNS de la red, pero las consultas pasan ahora por el túnel. Un DNS local solo es accesible con Permitir red local activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres noms utilisent toujours le DNS du réseau, mais les requêtes passent par le tunnel. Un DNS local nécessite d'activer Autoriser le réseau local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Namen nutzen weiter den DNS-Server des Netzwerks, aber Anfragen laufen nun durch den Tunnel. Ein lokaler DNS-Server ist nur mit aktiviertem Lokalen Netzwerk erreichbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere namen gebruiken nog steeds de DNS van het netwerk, maar de aanvragen gaan nu door de tunnel. Een lokale DNS-server is alleen bereikbaar als Lokaal netwerk toestaan aan staat."
          }
        }
      }
    },
    "killSwitch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
